# ===== قاعدة البيانات المشتركة (الأهم) =====
# الخيار المفضّل: Supabase (Postgres مجاني — 500MB) عبر واجهة REST، بلا أي مكتبة خارجية.
# من لوحة Supabase: Project Settings ← API Keys ← Secret keys ← أظهر المفتاح وانسخه.
#   SUPABASE_URL        = https://<project-ref>.supabase.co
#   SUPABASE_SECRET_KEY = sb_secret_...   (سيرفر فقط — لا يُرسل للمتصفح أبداً)
# الجدول المطلوب مرة واحدة من SQL Editor:
#   create table if not exists public.crm_kv (
#     key text primary key,
#     value jsonb not null,
#     updated_at timestamptz not null default now()
#   );
#   alter table public.crm_kv enable row level security;
#
# البديل: Upstash Redis / Vercel KV — يعمل تلقائياً لو Supabase غير مضبوط.
# يكفي زوج واحد فقط (Vercel KV أو Upstash مباشرة):
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== المُشغّل الدوري: توزيع أرقام الكامبين ٢٤/٧ بلا متصفح مفتوح =====
# قيمة عشوائية طويلة (٣٢ حرفاً مثلاً). بعد إضافتها اضبط خدمة الجدولة المجانية على:
#     https://<رابط موقعك>/api/cron?key=<نفس القيمة هنا>
CRON_SECRET=

# ===== بوابة حماية البيانات (اختيارية — لكنها مهمة لأن الموقع عام) =====
# لو ضبطت STORE_TOKEN على Vercel، لن يستطيع أي زاحف سحب بيانات العملاء من /api/store.
# مهم: ضع نفس القيمة في VITE_STORE_TOKEN **قبل البناء**، وإلا لن يتصل التطبيق بالقاعدة.
# (الحماية هنا تمنع الماسحات الآلية؛ الحماية الكاملة تحتاج تسجيل دخول على السيرفر.)
STORE_TOKEN=
VITE_STORE_TOKEN=

# ===== سقف حجم الطلب (اختياري) =====
# على Vercel السقف الصلب ٤.٥ ميجا. اتركه فارغاً إلا لو احتجت تغييره.
CRM_MAX_BODY=

# ===== سيرفر الشركة المحلي فقط (اختياري) =====
# مسارات ملفات البيانات لو أردت تشغيل نسخة تجريبية معزولة
CRM_DB_FILE=
CRM_SOURCE_FILE=
CRM_VAPID_FILE=
CRM_PUSH_STATE=
