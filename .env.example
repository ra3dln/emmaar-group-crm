# ===== متغيرات الاستضافة على Vercel =====
# تُضبط من لوحة Vercel: Settings → Environment Variables (لا تُرفع في ملف .env إلى git)
#
# عند إضافة قاعدة Redis مجانية من Vercel (Storage → Upstash) يتم ضبط هذه المتغيرات تلقائياً:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# وتعمل أيضاً لو استخدمت Upstash مباشرة:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
